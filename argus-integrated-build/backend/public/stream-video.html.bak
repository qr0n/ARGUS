<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>ARGUS - Camera Streamer</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    body {
      margin: 0;
      padding: 0;
      background: #1a1b1e;
      color: #e4e5e8;
      font-family: 'Inter', sans-serif;
      display: flex;
      flex-direction: column;
      height: 100vh;
      overflow: hidden;
    }
    header {
      padding: 16px;
      background: #272930;
      text-align: center;
      border-bottom: 1px solid rgba(255,255,255,0.05);
    }
    h1 {
      margin: 0;
      font-family: 'IBM Plex Mono', monospace;
      font-size: 20px;
      letter-spacing: 2px;
    }
    .status {
      font-size: 12px;
      font-family: 'IBM Plex Mono', monospace;
      color: #fbbf24;
      margin-top: 4px;
    }
    .video-container {
      flex: 1;
      position: relative;
      background: #000;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    video {
      width: 100%;
      height: 100%;
      object-fit: contain;
    }
    .controls {
      padding: 24px;
      background: #272930;
      display: flex;
      flex-direction: column;
      gap: 16px;
      padding-bottom: env(safe-area-inset-bottom, 24px);
    }
    .btn {
      background: #3bb4f2;
      color: #000;
      border: none;
      padding: 16px;
      border-radius: 8px;
      font-family: 'IBM Plex Mono', monospace;
      font-size: 16px;
      font-weight: 600;
      cursor: pointer;
    }
    .btn-secondary {
      background: transparent;
      color: #3bb4f2;
      border: 1px solid #3bb4f2;
    }
    .mode-label {
      text-align: center;
      font-size: 12px;
      color: #909296;
    }
  </style>
</head>
<body>

  <header>
    <h1>ARGUS UPLINK</h1>
    <div class="status" id="wsStatus">CONNECTING...</div>
  </header>

  <div class="video-container">
    <video id="video" autoplay playsinline muted></video>
  </div>

  <div class="controls">
    <div class="mode-label" id="modeLabel">Awaiting Camera Start</div>
    <button class="btn" id="startBtn">Start Camera</button>
    <button class="btn btn-secondary" id="switchBtn" style="display:none;">Switch Camera</button>
  </div>

  <script>
    const wsUrl = `wss://${window.location.host}/ws-stream`;
    const ws = new WebSocket(wsUrl);
    
    let pc = null;
    let localStream = null;
    let currentFacingMode = 'environment';
    let viewerWaiting = false;

    const video = document.getElementById('video');
    const startBtn = document.getElementById('startBtn');
    const switchBtn = document.getElementById('switchBtn');
    const wsStatus = document.getElementById('wsStatus');
    const modeLabel = document.getElementById('modeLabel');

    ws.onopen = () => {
      wsStatus.textContent = 'CONNECTED';
      wsStatus.style.color = '#38d399';
    };

    ws.onmessage = async (event) => {
      const msg = JSON.parse(event.data);
      console.log('WS msg:', msg);
      
      if (msg.type === 'viewer-ready') {
        viewerWaiting = true;
        wsStatus.textContent = 'VIEWER READY';
        // If we already have a stream, immediately trigger SDP handshake
        if (localStream && !pc) {
          createPeerConnection();
        }
      } else if (msg.type === 'answer' && pc) {
        await pc.setRemoteDescription(new RTCSessionDescription(msg.sdp));
      } else if (msg.type === 'ice' && pc) {
        if (msg.candidate) {
          await pc.addIceCandidate(new RTCIceCandidate(msg.candidate));
        }
      } else if (msg.type === 'viewer-gone') {
        viewerWaiting = false;
        wsStatus.textContent = 'VIEWER DISCONNECTED';
        if (pc) {
          pc.close();
          pc = null;
        }
      }
    };

    ws.onerror = () => {
      wsStatus.textContent = 'CONNECTION ERROR';
      wsStatus.style.color = '#ef4444';
    };

    async function startCamera(facingMode) {
      if (localStream) {
        localStream.getTracks().forEach(t => t.stop());
      }
      
      try {
        localStream = await navigator.mediaDevices.getUserMedia({
          video: { facingMode: facingMode },
          audio: false
        });
        
        video.srcObject = localStream;
        modeLabel.textContent = facingMode === 'environment' ? 'Rear Camera Active' : 'Front Camera Active';
        
        startBtn.style.display = 'none';
        switchBtn.style.display = 'block';

        if (pc) {
          // Replace track without renegotiating if possible
          const videoTrack = localStream.getVideoTracks()[0];
          const sender = pc.getSenders().find(s => s.track.kind === videoTrack.kind);
          if (sender) sender.replaceTrack(videoTrack);
        } else if (viewerWaiting) {
          createPeerConnection();
        }
      } catch (err) {
        alert('Camera error: ' + err.message);
      }
    }

    async function createPeerConnection() {
      pc = new RTCPeerConnection({
        iceServers: [{ urls: 'stun:stun.l.google.com:19302' }]
      });

      localStream.getTracks().forEach(track => pc.addTrack(track, localStream));

      pc.onicecandidate = (event) => {
        if (event.candidate) {
          ws.send(JSON.stringify({ type: 'ice', candidate: event.candidate }));
        }
      };

      const offer = await pc.createOffer();
      await pc.setLocalDescription(offer);
      ws.send(JSON.stringify({ type: 'offer', sdp: pc.localDescription }));
      
      wsStatus.textContent = 'STREAMING LIVE';
      wsStatus.style.color = '#3bb4f2';
    }

    startBtn.onclick = () => startCamera(currentFacingMode);
    
    switchBtn.onclick = () => {
      currentFacingMode = currentFacingMode === 'environment' ? 'user' : 'environment';
      startCamera(currentFacingMode);
    };

  </script>
</body>
</html>
