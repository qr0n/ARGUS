# Copy to backend/.env and fill in. Never commit .env.

# --- Required ---------------------------------------------------------------

# Random secret that signs session cookies (at least 32 characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# The URL people open the dashboard at. Used to build the sign-in callback URL
# (<ARGUS_PUBLIC_URL>/auth/callback) and as an allowed request origin.
# Local development with the Vite dev server:
ARGUS_PUBLIC_URL=http://localhost:5173

# Comma-separated sign-in providers: dev, google, entra
ARGUS_AUTH_PROVIDERS=dev

# --- Optional ---------------------------------------------------------------

# Address to listen on. 0.0.0.0 (default) lets a phone on the same Wi-Fi connect;
# 127.0.0.1 keeps the server reachable from this machine only.
# ARGUS_BIND_HOST=127.0.0.1

# Private data folder for face photos and the activity log (default: backend/data).
# Never inside a folder the web server publishes.
# ARGUS_DATA_DIR=

# Where role assignments are read from (default: backend/config/roles.json).
# ARGUS_ROLES_FILE=

# Address phones use to reach this server, used in pairing links and allowed as an
# origin for the phone streamer page. Default: https://<this machine's LAN IP>:3000
# ARGUS_STREAM_URL=

# Extra origins allowed to make changes / open WebSockets, comma-separated.
# https://localhost:3000, ARGUS_PUBLIC_URL and ARGUS_STREAM_URL are always allowed.
# ARGUS_ALLOWED_ORIGINS=

# --- Provider: dev (local login server, DEVELOPMENT ONLY) --------------------
# Start it with `npm run dev:idp`. These defaults match the dev server's defaults.
# ARGUS_DEV_IDP_ISSUER=http://localhost:4000
# ARGUS_DEV_IDP_CLIENT_ID=argus-local
# ARGUS_DEV_IDP_CLIENT_SECRET=argus-local-dev-secret

# --- Provider: google ---------------------------------------------------------
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application).
# Authorized redirect URI: <ARGUS_PUBLIC_URL>/auth/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Only accept accounts from this Google Workspace domain (optional):
# GOOGLE_ALLOWED_HD=example.com

# --- Provider: entra (Microsoft Entra ID, single tenant) ---------------------
# Entra admin center > App registrations. Redirect URI (Web): <ARGUS_PUBLIC_URL>/auth/callback
# ENTRA_TENANT_ID=
# ENTRA_CLIENT_ID=
# ENTRA_CLIENT_SECRET=
