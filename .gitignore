node_modules

# TLS keys and certificates: generate per machine, never commit (see README security notice)
*.pem
*.key
*.crt

# Environment files: commit a .env.example instead
.env
.env.*
!.env.example

# Biometric data and activity logs written by the servers at runtime
**/dataset/*
!**/dataset/.gitkeep

# Role assignments (names/emails of staff): copy roles.example.json
backend/config/roles.json

# Private runtime data: face photos and activity log (see backend/storage/)
backend/data/
